{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ma liseuse",
  "mainBinaryName": "ma-liseuse",
  "version": "0.3.0",
  "identifier": "it.hosh.liseuse",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/build-ui.mjs",
    "beforeDevCommand": "node scripts/build-ui.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Ma liseuse",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 700,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Pazka",
    "shortDescription": "La bibliothèque et la liseuse de Maman",
    "copyright": "Pazka",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBENENDQTgyNzc0MzdFQTkKUldTcGZrTjNnc3BNRFNHRk0vcm15SkRXWHdNMkR2K3BTVzRVRWNTS05tSzNmQWpqWnVXc1BZV3QK",
      "endpoints": [
        "https://github.com/pazka/kindle-for-mom/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
